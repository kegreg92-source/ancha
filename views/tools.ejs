<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container fade-in">
  <div class="page-header">
    <h1><i class="fas fa-list"></i> Tüm Tools</h1>
    <p>Paylaşılmış tüm Discord tool'ları burada bulabilirsiniz.</p>
  </div>

  <% if (tools && tools.length) { %>
    <div class="tools-grid">
      <% tools.forEach(tool => { %>
        <div class="tool-card">
          <div class="tool-card-header">
            <span class="badge"><i class="fas fa-download"></i> <%= tool.downloads || 0 %> indirme</span>
          </div>
          <h3><%= tool.title %></h3>
          <% if (tool.description) { %>
            <p class="tool-desc"><%= tool.description %></p>
          <% } %>
          <div class="tool-meta">
            <span class="tool-owner">
              <% if (tool.avatar) { %>
                <img src="/avatars/<%= tool.avatar %>" class="avatar-sm" alt="">
              <% } else { %>
                <div class="avatar-sm default"><i class="fas fa-user"></i></div>
              <% } %>
              <%= tool.username %>
            </span>
          </div>
          <a href="/download/<%= tool.id %>" class="btn btn-primary btn-block"><i class="fas fa-download"></i> İndir</a>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <p>Henüz hiç tool paylaşılmamış. İlk toolu siz paylaşın!</p>
      <% if (user) { %>
        <a href="/upload" class="btn btn-primary mt-2"><i class="fas fa-cloud-upload-alt"></i> Tool Paylaş</a>
      <% } %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
