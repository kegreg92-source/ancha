<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container fade-in">
  <div class="page-header">
    <h1><i class="fas fa-cloud-upload-alt"></i> Tool Paylaş</h1>
    <p>Discord toolunuzu buradan yükleyip diğer kullanıcılarla paylaşabilirsiniz.</p>
  </div>

  <div class="form-card">
    <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form">
      <div class="form-group">
        <label><i class="fas fa-tag"></i> Tool Başlığı <span class="required">*</span></label>
        <input type="text" name="title" placeholder="Örnek: Discord Token Alıcı v2" required>
      </div>
      <div class="form-group">
        <label><i class="fas fa-align-left"></i> Açıklama</label>
        <textarea name="description" rows="4" placeholder="Tool ne işe yarar? Kullanım talimatları..."></textarea>
      </div>
      <div class="form-group">
        <label><i class="fas fa-file"></i> Dosya <span class="required">*</span></label>
        <input type="file" name="file" required>
        <small class="form-hint">En büyük 50 MB boyutunda dosya yükleyebilirsiniz.</small>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-large"><i class="fas fa-cloud-upload-alt"></i> Toolu Paylaş</button>
    </form>
  </div>

  <div class="mt-3">
    <a href="/dashboard" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Geri Dön</a>
  </div>
</main>

<%- include('partials/footer') %>
